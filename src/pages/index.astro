---
import Layout from "../layouts/Layout.astro";
import TenantExplorer from "../components/TenantExplorer.astro";
import WritingSketch from "../components/WritingSketch.astro";
import "../styles/home.css";
import { getCollection } from "astro:content";
import { articleLabel, visibleArticles, readingMinutes } from "../lib/writing";

const projects = (await getCollection("work")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const articles = visibleArticles(await getCollection("writing"))
  .sort(
    (a, b) =>
      (b.data.publicationMonth ?? "").localeCompare(
        a.data.publicationMonth ?? "",
      ) || a.data.order - b.data.order,
  )
  .slice(0, 3);
const projectSketches = {
  "saas-modernisation": "tenancy",
  "cloud-and-recovery": "recovery",
  "engineering-leadership": "handover",
} as const;
---

<Layout description="Adam Riddick on software engineering, architecture and the decisions behind the work. Explore a system, read an article, or see the projects behind the thinking.">
  <div class="home-page">
    <div class="shell home-opening">
      <header class="home-intro" id="about">
        <div class="home-identity">
          <p class="home-overline">Software engineer &amp; architect</p>
          <h1>
            Adam{" "}
            <em>
              Riddick<span>.</span>
            </em>
          </h1>
        </div>
        <div class="home-intro-copy">
          <p class="home-introduction">
            I’m a Principal Architect working across SaaS modernisation, .NET
            engineering and the teams running software in production.
          </p>
          <p class="home-background">
            I write about the decisions behind that work: how systems fit
            together, what the trade-offs mean and what teams need to keep
            changing them.
          </p>
          <a class="home-text-link" href="/about/">
            More about me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>
    </div>

    <section class="home-reading" aria-labelledby="recent-writing">
      <div class="shell">
        <div class="home-section-heading">
          <div>
            <p class="home-overline">From experience</p>
            <h2 id="recent-writing">
              Recent <em>writing.</em>
            </h2>
          </div>
          <a class="home-text-link" href="/writing/">
            All writing <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="home-reading-list">
          {articles.map((article, index) => (
            <article class="home-reading-entry">
              <p class="home-reading-date">
                <time datetime={article.data.publicationMonth}>
                  {articleLabel(article.data)}
                </time>
              </p>
              <div class="home-reading-copy">
                <p class="home-overline">
                  {article.data.topic} · {readingMinutes(article.body ?? "")}{" "}
                  min read
                </p>
                <h3>
                  <a href={`/writing/${article.id}/`}>{article.data.title}</a>
                </h3>
                <p>{article.data.summary}</p>
              </div>
              <span class="home-reading-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="shell home-explanation"
      aria-labelledby="thinking-in-practice"
    >
      <div class="home-explanation-copy">
        <p class="home-overline">Thinking in practice · Architecture</p>
        <h2 id="thinking-in-practice">
          Where does
          <br />
          <em>the boundary sit?</em>
        </h2>
        <p>
          A shared application doesn’t have to mean a shared database. The
          request still needs a clear route to the right tenant’s data.
        </p>
        <p class="home-explanation-prompt">
          Try switching tenants. Then remove the context. Where should the
          request stop?
        </p>
        <a
          class="home-text-link"
          href="/writing/multitenant-application-separate-databases/"
        >
          Read the reasoning <span aria-hidden="true">↗</span>
        </a>
      </div>
      <TenantExplorer />
    </section>

    <section class="shell home-work" id="work" aria-labelledby="selected-work">
      <span id="expertise"></span>
      <div class="home-section-heading">
        <div>
          <p class="home-overline" id="experience">
            The work behind the thinking
          </p>
          <h2 id="selected-work">
            Selected <em>work.</em>
          </h2>
        </div>
        <p>
          Systems and practices I helped teams build.
          <br />
          <a href="/about/#experience">My roles and responsibilities ↗</a>
        </p>
      </div>
      <div class="home-work-grid">
        {projects.map((project) => (
          <a class="home-work-card" href={`/work/${project.id}/`}>
            <div class="home-work-image" aria-hidden="true">
              <WritingSketch
                kind={
                  projectSketches[project.id as keyof typeof projectSketches]
                }
                compact
              />
            </div>
            <p class="home-overline">{project.data.category}</p>
            <h3>
              {project.data.title}
              <span aria-hidden="true">↗</span>
            </h3>
            <p class="home-work-summary">{project.data.summary}</p>
            <p class="home-work-outcome">{project.data.outcome}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-contact" id="contact" aria-labelledby="get-in-touch">
      <div class="shell home-contact-inner">
        <div>
          <p class="home-overline">Continue the conversation</p>
          <h2 id="get-in-touch">
            Something to
            <br />
            <em>think through?</em>
          </h2>
        </div>
        <div class="home-contact-copy">
          <p>
            If a piece here connects with your own work, I’d be interested to
            hear about it.
          </p>
          <a href="mailto:adam@riddick.dev">
            adam@riddick.dev <span aria-hidden="true">↗</span>
          </a>
          <a
            class="home-linkedin"
            href="https://www.linkedin.com/in/adam-riddick/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Or find me on LinkedIn
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
