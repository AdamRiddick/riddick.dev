---
import "../../styles/writing.css";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Arrow from "../../components/Arrow.astro";
import WritingSketch from "../../components/WritingSketch.astro";
import {
  visibleArticles,
  articleLabel,
  readingMinutes,
} from "../../lib/writing";
const articles = visibleArticles(
  await getCollection("writing"),
  import.meta.env.DEV,
).sort((a, b) => {
  const monthA = a.data.draft ? "" : (a.data.publicationMonth ?? "");
  const monthB = b.data.draft ? "" : (b.data.publicationMonth ?? "");
  return monthB.localeCompare(monthA) || a.data.order - b.data.order;
});
const [featured, ...remaining] = articles;
const topics = [
  "All articles",
  "Architecture",
  "Operations & FinOps",
  "Technical leadership",
];
---

<Layout
  title="Writing — Adam Riddick"
  description="Practical notes on architecture, operations and the decisions that teams live with."
  noindex={import.meta.env.DEV}
>
  <div class="shell writing-index personal-writing">
    <header class="writing-intro">
      <div>
        <h1>
          Writing<span>.</span>
        </h1>
      </div>
      <div class="writing-intro-note">
        <p>
          Decisions, trade-offs and things I’ve learned from building software
          with teams.
        </p>
      </div>
    </header>
    {articles.length > 0 ? (
      <>
        <nav class="writing-filters" aria-label="Filter articles by topic">
          {topics.map((topic, i) => (
            <button
              type="button"
              data-writing-filter={i === 0 ? "all" : topic}
              aria-pressed={i === 0}
            >
              {topic}
            </button>
          ))}
        </nav>
        <div id="writing-results">
          {featured && (
            <a
              class="featured-note"
              href={`/writing/${featured.id}/`}
              data-writing-topic={featured.data.topic}
            >
              <div class="featured-copy">
                <div class="note-metadata">
                  <span>{featured.data.topic}</span>
                  {articleLabel(featured.data) && (
                    <span>{articleLabel(featured.data)}</span>
                  )}
                  <span>{readingMinutes(featured.body ?? "")} min read</span>
                </div>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.summary}</p>
                <span class="featured-read">
                  Read the article <Arrow diagonal />
                </span>
              </div>
              <WritingSketch kind={featured.data.sketch} compact />
            </a>
          )}
          <div class="notes-list">
            {remaining.map((article, i) => (
              <a
                class="note-row"
                href={`/writing/${article.id}/`}
                data-writing-topic={article.data.topic}
              >
                <span class="note-index">
                  {String(i + 2).padStart(2, "0")} /
                </span>
                <div class="note-row-copy">
                  <div class="note-metadata">
                    <span>{article.data.topic}</span>
                    {articleLabel(article.data) && (
                      <span>{articleLabel(article.data)}</span>
                    )}
                    <span>{readingMinutes(article.body ?? "")} min read</span>
                  </div>
                  <h2>{article.data.title}</h2>
                  <p>{article.data.summary}</p>
                </div>
                <span class="circle-arrow">
                  <Arrow diagonal />
                </span>
              </a>
            ))}
          </div>
        </div>
        <p
          class="sr-only"
          role="status"
          aria-live="polite"
          data-writing-status
        ></p>
      </>
    ) : (
      <div class="writing-empty">
        <p class="eyebrow">TAKING SHAPE</p>
        <h2>
          The first articles
          <br />
          <em>are on their way.</em>
        </h2>
        <p>
          I’m putting together a small collection of useful articles. In the
          meantime, you can explore the work behind them.
        </p>
        <a class="text-link" href="/#work">
          See selected work <Arrow diagonal />
        </a>
      </div>
    )}
    <aside class="writing-endnote">
      <p class="eyebrow">A note on these notes</p>
      <p>
        Good architecture needs context. These pieces explore the choices,
        constraints and responsibilities behind the systems we build, with room
        for a different answer in a different situation.
      </p>
      <a class="text-link" href="mailto:adam@riddick.dev">
        Have a question worth exploring? <Arrow diagonal />
      </a>
    </aside>
  </div>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>(
      "[data-writing-filter]",
    );
    const articles = document.querySelectorAll<HTMLElement>(
      "[data-writing-topic]",
    );
    const status = document.querySelector("[data-writing-status]");
    filters.forEach((button) =>
      button.addEventListener("click", () => {
        const topic = button.dataset.writingFilter;
        filters.forEach((filter) =>
          filter.setAttribute("aria-pressed", String(filter === button)),
        );
        let count = 0;
        articles.forEach((article) => {
          const show =
            topic === "all" || article.dataset.writingTopic === topic;
          article.hidden = !show;
          if (show) count++;
        });
        if (status)
          status.textContent = `${count} ${count === 1 ? "article" : "articles"} shown${topic === "all" ? "" : ` for ${topic}`}.`;
      }),
    );
  </script>
</Layout>
