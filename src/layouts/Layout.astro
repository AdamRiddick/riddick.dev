---
import "../styles/global.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  noindex = false,
  title = "Adam Riddick — Principal Architect",
  description = "Principal Architect with 13+ years in software engineering. SaaS modernisation, Azure architecture and engineering leadership. Based in the UK.",
} = Astro.props;
const home = Astro.url.pathname === "/";
const navigation = [
  {
    label: "Writing",
    href: "/writing/",
    current:
      Astro.url.pathname === "/writing/"
        ? "page"
        : Astro.url.pathname.startsWith("/writing/")
          ? "location"
          : undefined,
  },
  {
    label: "Work",
    href: home ? "#work" : "/#work",
    current: Astro.url.pathname.startsWith("/work/") ? "location" : undefined,
  },
  {
    label: "About",
    href: "/about/",
    current: Astro.url.pathname === "/about/" ? "page" : undefined,
  },
] as const;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/portfolio-preview.png", Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f7f0" />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical.href} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={shareImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="627" />
        <meta
          property="og:image:alt"
          content="Adam Riddick — Architecture portfolio"
        />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="sitemap" href={new URL("/sitemap-index.xml", Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="shell flex items-center justify-between gap-5">
        <a class="wordmark" href="/" aria-label="Adam Riddick home">
          <span class="monogram">
            ar<span>.</span>
          </span>
          <span>
            Adam Riddick<span class="wordmark-role">Principal Architect</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((link) => (
            <a href={link.href} aria-current={link.current}>
              {link.label}
            </a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Toggle navigation">
            Menu <span aria-hidden="true">+</span>
          </summary>
          <nav aria-label="Mobile navigation">
            {navigation.map((link) => (
              <a href={link.href} aria-current={link.current}>
                {link.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell flex flex-wrap items-center justify-between gap-5">
        <a href="/" class="footer-name">
          Adam Riddick
        </a>
        <div class="flex flex-wrap items-center gap-6">
          <a
            href="https://www.linkedin.com/in/adam-riddick/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
          <a href="mailto:adam@riddick.dev">Email</a>
          <span class="copyright">© 2026</span>
        </div>
      </div>
    </footer>
    <script>
      document.querySelectorAll(".mobile-menu nav a").forEach((link) =>
        link.addEventListener("click", () => {
          document.querySelector(".mobile-menu")?.removeAttribute("open");
        }),
      );
    </script>
  </body>
</html>
