---
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<figure class:list={["case-diagram", kind]}>
  {kind === "saas-modernisation" && (
    <>
      <p class="diagram-label">Modernisation across an established estate</p>
      <div class="platform-services">
        <span>Reporting</span>
        <span>Integration</span>
        <span>Identity</span>
      </div>
      <div class="platform-connection" aria-hidden="true">
        ↕
      </div>
      <div class="platform-modules">
        API-first .NET components
        <br />
        <small>Multi-tenant application modules</small>
      </div>
      <div class="platform-connection" aria-hidden="true">
        ↕
      </div>
      <div class="platform-core">Single-tenant backbone &amp; database</div>
      <figcaption>
        Conceptual layers from the case study. Relationships are simplified;
        this is not a production topology.
      </figcaption>
    </>
  )}
  {kind === "cloud-and-recovery" && (
    <>
      <p class="diagram-label">Three connected operational concerns</p>
      <div class="operations-map">
        <div>
          <span aria-hidden="true">£</span>
          <h3>Cost</h3>
          <p>
            Backups, sizing
            <br />
            and retirement
          </p>
        </div>
        <div>
          <span aria-hidden="true">↗</span>
          <h3>Provisioning</h3>
          <p>
            Environment setup
            <br />
            from days to hours
          </p>
        </div>
        <div>
          <span aria-hidden="true">↺</span>
          <h3>Recovery</h3>
          <p>
            Observability
            <br />
            and incident response
          </p>
        </div>
      </div>
      <p class="operations-foundation">Service ownership across the teams</p>
      <figcaption>
        Separate initiatives across architecture and engineering leadership
        roles, shown together for context.
      </figcaption>
    </>
  )}
  {kind === "engineering-leadership" && (
    <>
      <p class="diagram-label">Shared practices around delivery</p>
      <div class="practice-map">
        <div>
          <h3>Review</h3>
          <p>
            Design decisions
            <br />
            and peer review
          </p>
        </div>
        <div>
          <h3>Security</h3>
          <p>
            Threat modelling
            <br />
            and audit evidence
          </p>
        </div>
        <div>
          <h3>Delivery</h3>
          <p>
            Shared lifecycle
            <br />
            and release practices
          </p>
        </div>
        <div>
          <h3>Operations</h3>
          <p>
            Clear production
            <br />
            ownership
          </p>
        </div>
        <p class="practice-centre">
          The teams
          <br />
          <small>carrying the work forward</small>
        </p>
      </div>
      <figcaption>
        A conceptual view of the practices described here, rather than an
        organisation chart or delivery sequence.
      </figcaption>
    </>
  )}
</figure>

<style>
  .case-diagram {
    margin: 0;
    padding: 28px;
    background: #e9ecdf;
    border: 1px solid #c8d0bc;
    color: #203c34;
  }
  .diagram-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    line-height: 1.6;
    margin: 0 0 26px;
  }
  .case-diagram figcaption {
    font-size: 12px;
    line-height: 1.7;
    color: #52614c;
    margin-top: 24px;
  }
  .platform-services {
    display: flex;
    gap: 8px;
  }
  .platform-services span {
    flex: 1;
    padding: 14px 4px;
    border: 1px solid #9bad93;
    text-align: center;
    font-size: 14px;
    background: #f7f7f0;
  }
  .platform-modules,
  .platform-core {
    padding: 18px 12px;
    text-align: center;
    font-size: 16px;
  }
  .platform-modules {
    background: #174d43;
    color: #f7f7f0;
  }
  .platform-modules small {
    font-size: 12px;
    color: #dcebbd;
  }
  .platform-core {
    border: 1px solid #9bad93;
    background: #f7f7f0;
  }
  .platform-connection {
    text-align: center;
    font-size: 22px;
    line-height: 1.4;
    color: #52614c;
  }
  .operations-map {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .operations-map > div {
    text-align: center;
  }
  .operations-map > div > span {
    display: block;
    font-family: "Instrument Serif", serif;
    font-size: 42px;
    color: #174d43;
    margin-bottom: 12px;
  }
  .case-diagram h3 {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 10px;
  }
  .operations-map p,
  .practice-map div p {
    font-size: 13px;
    line-height: 1.7;
    color: #52614c;
    margin: 0;
  }
  .operations-foundation {
    padding: 14px;
    background: #174d43;
    color: #f7f7f0;
    font-size: 14px;
    text-align: center;
    margin: 24px 0 0;
  }
  .practice-map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 62px 16px;
    position: relative;
  }
  .practice-map > div {
    padding: 18px 12px;
    border: 1px solid #9bad93;
    background: #f7f7f0;
  }
  .practice-centre {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 78%;
    margin: 0;
    background: #174d43;
    color: #f7f7f0;
    padding: 10px;
    text-align: center;
    font-size: 16px;
    line-height: 1.3;
  }
  .practice-centre small {
    font-size: 12px;
    color: #dcebbd;
  }
  @media (max-width: 580px) {
    .case-diagram {
      padding: 20px 16px;
    }
    .platform-services {
      gap: 5px;
    }
    .platform-services span {
      font-size: 12px;
    }
    .operations-map {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .operations-map > div {
      display: grid;
      grid-template-columns: 45px 1fr;
      gap: 0 12px;
      text-align: left;
    }
    .operations-map > div > span {
      grid-row: 1 / 3;
      font-size: 36px;
    }
    .operations-map h3 {
      margin-bottom: 4px;
    }
  }
</style>
